# KingProm frontend
# Proxy admin + public API to the backend (Next.js rewrites)
API_PROXY_TARGET=http://localhost:4000

# Deploy-time TENANT branding only (not an auth credential).
# Seed hospitality tenant for this monorepo is Blue Top Villa.
NEXT_PUBLIC_TENANT_ID=blue-top-villa
NEXT_PUBLIC_TENANT_NAME=Blue Top Villa
# Optional alias used by older helpers
NEXT_PUBLIC_BRAND_NAME=Blue Top Villa

# Platform brand is KingProm (see lib/platform.js). Tenant branding above is org-specific.
